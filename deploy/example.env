PUBLIC_ORIGIN=https://kids.usamif.com
REQUIRE_GUARDIAN_CONSENT=true
ADMIN_EMAIL=replace-with-admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-unique-secret
# Legacy HTTPS mail webhook for password reset; EMAIL_WEBHOOK_URL takes precedence.
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=
# HTTPS delivery endpoint for {to,template,verificationUrl|resetUrl}, with optional Bearer authentication.
# Configure this before creating child accounts in production; confirm both email templates arrive.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
