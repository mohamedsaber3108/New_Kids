# USAM_New API configuration. Copy to a protected .env beside docker-compose.yml
# (chmod 600 .env). Never commit real values. The API validates these at startup and
# refuses to boot in production if they are unsafe (see server/config.mjs).

# --- Required in production ---
# Exact browser origin (scheme://host[:port], no path). Must be https in production.
PUBLIC_ORIGIN=https://kids.usamif.com
NODE_ENV=production

# --- Staff accounts (created once at first boot; never overwritten afterwards) ---
# Each pair must be set together; passwords must be at least 12 characters.
ADMIN_EMAIL=replace-with-admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-unique-secret
# Optional: a moderator for the /moderator desk (report review). Leave both empty to skip.
MODERATOR_EMAIL=
MODERATOR_PASSWORD=

# --- Child safety ---
# Require versioned guardian consent before a guardian can create a child profile.
REQUIRE_GUARDIAN_CONSENT=true

# --- Email delivery (verification + password recovery) ---
# HTTPS endpoint that receives {to, template, verificationUrl|resetUrl} and actually sends
# the email. Without it, verification/recovery honestly return "unavailable".
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Legacy names (EMAIL_WEBHOOK_* takes precedence):
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=

# --- Operations ---
# One JSON line per request (method, path without query string, status, duration, requestId).
# Set to false to disable request logs (startup/error logs remain).
LOG_REQUESTS=true
