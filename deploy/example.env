# USAM_New API configuration. Copy to a protected .env beside docker-compose.yml
# (chmod 600 .env). Never commit real values. The API validates these at startup and
# refuses to boot in production if they are unsafe (see server/config.mjs).

# --- Required in production ---
# Exact browser origin (scheme://host[:port], no path). Must be https in production.
PUBLIC_ORIGIN=https://kids.usamif.com
NODE_ENV=production

# --- Staff accounts (created once at first boot; never overwritten afterwards) ---
# Each pair must be set together; passwords must be at least 12 characters.
ADMIN_EMAIL=replace-with-admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-unique-secret
# Optional: a moderator for the /moderator desk (report review). Leave both empty to skip.
MODERATOR_EMAIL=
MODERATOR_PASSWORD=

# --- Child safety ---
# Require versioned guardian consent before a guardian can create a child profile.
REQUIRE_GUARDIAN_CONSENT=true

# --- Email delivery (verification + password recovery) ---
# Without a provider, verification and recovery honestly return "unavailable".
# EMAIL_PROVIDER = postmark | sendgrid | webhook
EMAIL_PROVIDER=
# postmark / sendgrid: provider API token + a verified sender address on your domain.
EMAIL_API_TOKEN=
EMAIL_FROM=no-reply@kids.usamif.com
# webhook: HTTPS endpoint receiving {to, template, verificationUrl|resetUrl, subject, text, html}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Legacy names (EMAIL_WEBHOOK_* takes precedence):
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=

# --- Live AI companions (optional; OFF by default) ---
# Live answers are used ONLY for children whose guardian opted in (liveAiAllowed).
# Everyone else, and every provider failure, gets the rule-based guidance.
# AI_PROVIDER = openai | anthropic   (openai also works for any OpenAI-compatible HTTPS API via AI_BASE_URL)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_DAILY_LIMIT_PER_LEARNER=30
AI_TIMEOUT_MS=8000

# --- Payments (optional; billing stays FREE_ACCESS until plans are approved) ---
# Signed webhook endpoint: POST /api/payments/webhook with header x-usam-signature: t=<unix>,v1=<hmac>
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- Operations ---
# One JSON line per request (method, path without query string, status, duration, requestId).
# Set to false to disable request logs (startup/error logs remain).
LOG_REQUESTS=true
